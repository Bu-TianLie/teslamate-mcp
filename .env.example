# When this compose file joins TeslaMate's Docker network, the database service
# is usually reachable as "database".
DATABASE_URL=postgresql://teslamate:password@database:5432/teslamate

# Run `docker network ls` on the TeslaMate host and set this to the network that
# contains the TeslaMate `database` container. Common default: teslamate_default.
TESLAMATE_DOCKER_NETWORK=teslamate_default

# Xiaomi phone / MiClaw should usually use SSE:
# http://<teslamate-host-lan-ip>:8000/sse
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Used to interpret date-only search ranges such as 2026-05-03.
# TeslaMate stores timestamps in UTC; this server converts local dates to UTC.
LOCAL_TIMEZONE=Asia/Shanghai

# Optional tuning.
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=4
DATABASE_COMMAND_TIMEOUT=10
